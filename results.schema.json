_id":{"type":"string"}},"required":["rank","track","artist","track_id","spotify_id","spotify_url","score","audio_features_present","match_label","mood_tags","audio_features","breakdown","reason"],"type":"object"},"type":"array"},"schema":{"const":"cwi.sonic-result/1.0"}},"required":["schema","app","query","deep_link","parsed","coverage","honest_limits","clearance","results","result_count"],"title":"CWI Sonic Search result payload","type":"object"}