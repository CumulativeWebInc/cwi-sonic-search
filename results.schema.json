{"$id":"https://cumulativewebinc.github.io/cwi-sonic-search/results.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Machine-readable output of a Sonic Search query (cwi.sonic-result/1.0). Every scored result carries its score breakdown and a reason string citing actual measured values. Tracks without audio features carry match_label 'no audio features on file — tag match only' and score numeric criteria as null (never estimated).","properties":{"app":{"const":"Sonic Search"},"clearance":{"description":"Sync clearance contact line","type":"string"},"coverage":{"properties":{"source":{"description":"Audio feature provenance","type":"string"},"total":{"description":"Total tracks in the searchable catalog (currently 35)","type":"integer"},"with_audio_features":{"description":"Tracks carrying measured audio features (currently 6)","type":"integer"}},"required":["with_audio_features","total","source"],"type":"object"},"deep_link":{"description":"Shareable ?q= deep link reproducing this result set","type":"string"},"honest_limits":{"description":"Verbatim honest-limits wording; must be surfaced wherever results are shown","type":"string"},"parsed":{"description":"Structured intent extracted from the query","properties":{"artists":{"description":"Artist lanes requested","items":{"type":"string"},"type":"array"},"danceability":{"properties":{"label":{"type":"string"},"min":{"type":"number"}},"type":["object","null"]},"energy":{"properties":{"label":{"type":"string"},"max":{"type":"number"},"min":{"type":"number"}},"type":["object","null"]},"key":{"properties":{"name":{"type":"string"},"pitchClass":{"maximum":11,"minimum":0,"type":"integer"}},"type":["object","null"]},"mode":{"enum":["minor","major",null],"type":["string","null"]},"moods":{"description":"Editorial mood tags requested","items":{"type":"string"},"type":"array"},"tempo":{"properties":{"label":{"type":"string"},"max":{"type":"number"},"min":{"type":"number"}},"type":["object",